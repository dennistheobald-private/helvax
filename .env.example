# Copy to apps/app/.env.local for local development.
# On Vercel, set these per project (Settings > Environment Variables).

# Public URLs, used for links between the two apps
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3001

# Supabase (phase 3). The URL and anon key are safe in the browser.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server only. Never prefix with NEXT_PUBLIC_ and never commit a real value.
SUPABASE_SERVICE_ROLE_KEY=

# Resend, for login and invite emails (phase 3). Server only.
RESEND_API_KEY=
