# Copy to apps/app/.env.local for local development.
# On Vercel, set these per project (Settings > Environment Variables).

# Public URLs, used for links between the two apps
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3001

# Supabase. The URL and publishable key (sb_publishable_...) are safe in the browser.
NEXT_PUBLIC_SUPABASE_URL=https://bdslminoysfjsetgljlb.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Server only. Never prefix with NEXT_PUBLIC_ and never commit a real value.
SUPABASE_SERVICE_ROLE_KEY=

# Resend, for login, invite and demo-request emails. Server only.
RESEND_API_KEY=
# App: sender for invitation emails.
EMAIL_FROM=Helvax <hello@mail.helvax.ch>
# Marketing site: where demo requests are sent, and the sender address.
DEMO_REQUEST_TO=
DEMO_REQUEST_FROM=Helvax <hello@mail.helvax.ch>
